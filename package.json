{
  "name": "desarrollo-tp",
  "type": "module",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "start:dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node ./dist/index.js\"",
    "demo:generate": "node ./dist/Shared/db/demo/generate.js",
    "demo:load": "node ./dist/Shared/db/demo/load.js",
    "demo:reservations": "node ./dist/Shared/db/demo/load.js --reservations",
    "db:drop-legacy": "node ./dist/Shared/db/dropLegacy.js",
    "test": "node --import tsx --test \"tests-catedra/unit/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests-catedra/integration/*.db.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^25.9.3",
    "tsc-watch": "^6.0.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mikro-orm/core": "7.1.11",
    "@mikro-orm/decorators": "^7.1.11",
    "@mikro-orm/mysql": "^7.1.11",
    "@mikro-orm/sql-highlighter": "1.0.1",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "9.0.2",
    "reflect-metadata": "0.2.2",
    "zod": "^4.4.3"
  },
  "description": ""
}
